{
  "name": "@zhubai0528/dsh-client-ui-aqua-community-fix",
  "description": "Aqua glass theme for DeepSeek Harness V0.2.1-rc.2 — adjustable blur, frost, fluid or wallpaper backdrop, unified corners, and motion",
  "version": "2.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZHUBAI0528/dsh-client-ui-aqua.git"
  },
  "homepage": "https://github.com/ZHUBAI0528/dsh-client-ui-aqua#readme",
  "bugs": {
    "url": "https://github.com/ZHUBAI0528/dsh-client-ui-aqua/issues"
  },
  "author": "ZHUBAI0528",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "glassmorphism",
    "blur",
    "deepseek-harness",
    "desktop",
    "frosted-glass"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bundle": "tsdown && node scripts/inline-css.mjs && node scripts/esm2cjs.mjs && node scripts/write-checksums.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "prepublishOnly": "npm run bundle"
  },
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5",
    "@testing-library/react": "^16.1.0",
    "@tsdown/css": "^0.23.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.d.ts",
    "lib/invariant.js",
    "lib/invariant.d.ts",
    "cordis.patch.yml",
    "assets"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
